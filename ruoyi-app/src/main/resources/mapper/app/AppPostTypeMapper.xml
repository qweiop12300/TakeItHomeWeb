<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.app.mapper.AppPostTypeMapper">
    
    <resultMap type="AppPostType" id="AppPostTypeResult">
        <result property="name"    column="name"    />
        <result property="id"    column="id"    />
        <result property="icon"    column="icon"    />
    </resultMap>

    <sql id="selectAppPostTypeVo">
        select name, id, icon from app_post_type
    </sql>

    <select id="selectAppPostTypeList" parameterType="AppPostType" resultMap="AppPostTypeResult">
        <include refid="selectAppPostTypeVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
        </where>
    </select>
    
    <select id="selectAppPostTypeById" parameterType="Long" resultMap="AppPostTypeResult">
        <include refid="selectAppPostTypeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAppPostType" parameterType="AppPostType" useGeneratedKeys="true" keyProperty="id">
        insert into app_post_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="icon != null">icon,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="icon != null">#{icon},</if>
         </trim>
    </insert>

    <update id="updateAppPostType" parameterType="AppPostType">
        update app_post_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppPostTypeById" parameterType="Long">
        delete from app_post_type where id = #{id}
    </delete>

    <delete id="deleteAppPostTypeByIds" parameterType="String">
        delete from app_post_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>