<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.app.mapper.AppMessageTypeMapper">
    
    <resultMap type="AppMessageType" id="AppMessageTypeResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
    </resultMap>

    <sql id="selectAppMessageTypeVo">
        select id, name from app_message_type
    </sql>

    <select id="selectAppMessageTypeList" parameterType="AppMessageType" resultMap="AppMessageTypeResult">
        <include refid="selectAppMessageTypeVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
    
    <select id="selectAppMessageTypeById" parameterType="Long" resultMap="AppMessageTypeResult">
        <include refid="selectAppMessageTypeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAppMessageType" parameterType="AppMessageType">
        insert into app_message_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
         </trim>
    </insert>

    <update id="updateAppMessageType" parameterType="AppMessageType">
        update app_message_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppMessageTypeById" parameterType="Long">
        delete from app_message_type where id = #{id}
    </delete>

    <delete id="deleteAppMessageTypeByIds" parameterType="String">
        delete from app_message_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>